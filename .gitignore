# Whitelist: ignore everything by default; track only what is listed below.
# New artifacts (runs, caches, secrets) are ignored automatically.
*

# Re-enter all directories so git can look inside them
!*/

# Top-level files
!.gitignore
!README.md
!CONTRIBUTING.md
!pyproject.toml

# Source package (python only — pycache/egg-info stay ignored)
!corpuslab/**/*.py

# Documentation
!docs/**/*.md

# Tests
!tests/**/*.py

# Examples: configs only (raw materials and run outputs are not tracked)
!examples/*.yaml
!examples/*.yml
